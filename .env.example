# ---- Database ----
DATABASE_URL="postgresql://presales:presales@localhost:5432/presales?schema=public"

# ---- Redis (BullMQ) ----
REDIS_URL="redis://localhost:6380"

# ---- Auth.js ----
# Generate: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only allow sign-ups from this email domain (leave blank to allow any)
ALLOWED_EMAIL_DOMAIN="clustox.com"
# Local-only login bypass (NEVER set true in production)
DEV_AUTH="false"

# ---- AI providers (pluggable) ----
AI_PROVIDER="anthropic"            # "anthropic" | "openai"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---- Object storage (S3 / R2) — added in milestone 1 ----
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="presales-attachments"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
